# Firebase (Console > Project settings > General > Your apps > Web app > SDK config)
# Copiar este archivo a .env.local y completar los valores.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Avisos push: Console > Project settings > Cloud Messaging > Web Push certificates > Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (solo servidor; NO usar prefijo NEXT_PUBLIC_)
# Console > Project settings > Service accounts > Generate new private key.
# Copiar client_email y private_key del JSON (la clave entre comillas, con los \n tal cual).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Tarea diaria de avisos de entrega (Vercel la envía sola como Bearer). Cualquier texto largo y secreto.
CRON_SECRET=

# Importar resúmenes de tarjeta con IA (Claude Haiku). Crear la clave en console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
# Opcional: secreto para cifrar la huella del titular de los resúmenes (si falta se usa FIREBASE_PRIVATE_KEY).
STATEMENT_HASH_SECRET=
