# Firebase (Console > Project settings > General > Your apps > Web app > SDK config)
# Copiar este archivo a .env.local y completar los valores.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (solo servidor; NO usar prefijo NEXT_PUBLIC_)
# Console > Project settings > Service accounts > Generate new private key.
# Copiar client_email y private_key del JSON (la clave entre comillas, con los \n tal cual).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
