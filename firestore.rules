rules_version = '2';

// Toda lectura/escritura pasa por el servidor (firebase-admin en Server
// Components y Server Actions), que ignora estas reglas. El SDK cliente no
// accede a Firestore, así que se bloquea todo acceso directo desde el navegador.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
